void setup() {
   pinMode(13, OUTPUT); // Pin 13 wird als Output ausgewählt 
}

void loop() {
  digitalWrite(13, HIGH); // Port 13 wird aktiviert
  delay(1000); // Programm Wartet eine sekunde
  digitalWrite(13, LOW); // Port 13 wird deaktiviert
  delay(1000) // Programm Wartet eine sekunde
 }













 
